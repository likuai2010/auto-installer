    "version": "0.2.0",
    "configurations": [
        {
            "name": "hap_installer",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "hap_installer (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "hap_installer (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Run Build Runner Task",
            "type": "dart",
            "request": "launch",
            "command": "dart pub run build_runner build --delete-conflicting-outputs",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}